# Demo settings. scripts/configure.sh copies this file to .env (and adds a Grafana password).
# Edit .env, not this file. .env is git-ignored.

# Value of the "env" label on every metric (the "env" selector in the Confluent Grafana
# dashboards) and of deployment.environment.name on logs and traces.
DEMO_ENV=demo

# Value of the "cluster" label on metrics and of confluent.cluster.name on logs and traces.
DEMO_CLUSTER_NAME=cp-demo

# Grafana admin password (user "demo"). Generated by scripts/configure.sh when empty.
GRAFANA_PASSWORD=
